# Copy to `.env`. All three come from the Supabase dashboard.

# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Project Settings → Database → Connection string → Session pooler.
# Must be the pooler string, not `db.<ref>.supabase.co`: the direct host is
# IPv6-only and unreachable from most networks. Server-only — never expose it
# under a NEXT_PUBLIC_ name.
CONNECTION_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
